#!/bin/sh
set -eu

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$STAGED" | grep -Eq '^(crates/|apps/|plugins/|Cargo\.toml$|rust-toolchain\.toml$|\.github/workflows/|scripts/)'; then
    if ! printf '%s\n' "$STAGED" | grep -qx 'PROGRESS.md'; then
        cat >&2 <<'EOF'
Slopity workflow check failed: implementation/build files are staged without PROGRESS.md.
Follow AGENTS.md and complete the declared step entry with the implementation commit.
EOF
        exit 1
    fi
fi
